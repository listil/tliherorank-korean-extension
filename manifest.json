{
  "manifest_version": 3,
  "name": "TLI Hero Rank 한국어 번역",
  "version": "1.0.0",
  "description": "tliherorank.com의 히어로 랭킹 페이지를 한국어로 번역합니다. 게임 용어는 tlidb.com 기준이며, 스킬/팩트스피릿 툴팁은 마우스오버 시 tlidb.com에서 실시간으로 가져옵니다.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "src/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "permissions": ["storage"],
  "host_permissions": ["https://tlidb.com/*"],
  "background": {
    "service_worker": "src/background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://tliherorank.com/*"],
      "js": ["src/content.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["data/dictionary.json", "data/ui-strings.json", "data/hero-names.json"],
      "matches": ["https://tliherorank.com/*"]
    }
  ]
}
