{
  "manifest_version": 3,
  "name": "토치라이트 인피니트 한국 유저 도구",
  "version": "1.1.1",
  "description": "tliherorank.com 히어로 랭킹 페이지 한국어 번역, TLI 커뮤니티/DB 바로가기, VoraxRoom 카드 추천을 제공하는 Torchlight Infinite 유저 도구.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "src/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "permissions": ["storage"],
  "host_permissions": ["https://tlidb.com/*"],
  "background": {
    "service_worker": "src/background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://tliherorank.com/*"],
      "js": ["src/content.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://madstone290.github.io/VoraxRoom/*"],
      "js": ["src/vorax-recommender.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["data/dictionary.json", "data/ui-strings.json", "data/hero-names.json"],
      "matches": ["https://tliherorank.com/*"]
    }
  ]
}
